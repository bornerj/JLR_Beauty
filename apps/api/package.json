{
  "name": "api",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "fix:avatar-urls": "tsx scripts/fixAvatarUploadUrls.ts",
    "seed:admin-v2-test-data": "tsx scripts/seedAdminV2TestData.ts",
    "seed:franchise-pipeline-test-data": "tsx scripts/seedFranchisePipelineTestData.ts",
    "seed:subscription-health-test-data": "tsx scripts/seedSubscriptionHealthTestData.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "tsx prisma/seed.ts",
    "seed:build": "esbuild prisma/seed.ts --bundle --platform=node --outfile=dist/seed.js --external:@prisma/client --external:dotenv",
    "test:greeting": "tsx --test src/lib/conciergeOpening.test.ts",
    "test:inventory": "JWT_SECRET=test-only-secret-not-used-for-anything-real-0000 tsx --test src/lib/stockLedger.test.ts src/lib/stockReservation.test.ts src/middleware/auth.test.ts",
    "test:intelligence": "tsx --test src/modules/intelligence/unit-health/scoring.test.ts src/modules/intelligence/operational-orders/classifier.test.ts src/modules/intelligence/capacity/heatmap.test.ts src/modules/intelligence/portfolio/classifier.test.ts src/modules/intelligence/service-performance/classifier.test.ts src/modules/intelligence/customers/classifier.test.ts src/modules/intelligence/subscriptions/classifier.test.ts src/modules/intelligence/franchise-pipeline/metrics.test.ts src/modules/intelligence/radar/rules.test.ts src/modules/intelligence/gargalos/rules.test.ts src/modules/intelligence/money/rules.test.ts src/modules/intelligence/comparator/rules.test.ts src/modules/intelligence/network/impact.test.ts src/modules/intelligence/network/narrative.test.ts src/modules/intelligence/insights/rules.test.ts src/modules/intelligence/insights/recommendations.test.ts",
    "test": "npm run test:greeting && npm run test:inventory && npm run test:intelligence"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@types/cookie-parser": "^1.4.10",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.0.0",
    "stripe": "^20.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^25.0.10",
    "prisma": "^5.22.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "prisma": {
    "seed": "node dist/seed.js"
  }
}
