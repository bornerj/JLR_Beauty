# =============================================================
# JLR Beauty — variáveis de ambiente para Docker / VPS
# Copie para .env e preencha os valores antes de rodar
# =============================================================

# --- PostgreSQL --- (gere cada senha com: openssl rand -hex 24; a senha de DB_API_RW_PASSWORD deve ser a mesma usada em DATABASE_URL)
POSTGRES_DB=jlrbeauty
POSTGRES_USER=jlrbeauty
POSTGRES_PASSWORD=troque-por-senha-forte
DB_API_RW_PASSWORD=troque-por-senha-forte
DB_API_RO_PASSWORD=troque-por-senha-forte

# --- API (Express) --- SEC-23: Use jlr_api_rw (least privilege) instead of admin user
DATABASE_URL=postgresql://jlr_api_rw:troque-por-senha-forte@postgres:5432/jlrbeauty
PORT=3001

APP_API_URL=http://SEU_DOMINIO_OU_IP
APP_WEB_URL=http://SEU_DOMINIO_OU_IP
CORS_ORIGIN=http://SEU_DOMINIO_OU_IP

JWT_SECRET=TROQUE_POR_SECRET_COM_MINIMO_32_CARACTERES
# SEC-25: access token de curta duração (15min) — refresh token (7d, revogável) renova a sessão
JWT_EXPIRES_IN=15m
# TLS_ENABLED=true só quando o domínio tiver HTTPS de verdade (PLAN-0019). Enquanto false (ou
# ausente), o cookie de refresh não usa `Secure` — necessário pra funcionar sobre HTTP puro
# (um cookie `Secure` é descartado pelo navegador em HTTP, quebrando a renovação de sessão
# silenciosa e forçando login a cada 15min). Setar true assim que o TLS estiver ativo.
TLS_ENABLED=false

AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX_ATTEMPTS=8
AUTH_RATE_LIMIT_BLOCK_MS=900000
# PLAN-0042: teto de falhas POR CONTA (qualquer IP) na mesma janela; bem maior que o do par IP+e-mail
AUTH_ACCOUNT_RATE_LIMIT_MAX_ATTEMPTS=30

# --- Usuário master (criado no seed) ---
MASTER_EMAIL=seu@email.com
MASTER_PASSWORD=SenhaSeguraMaster@123

# --- Mercado Pago (PLAN-0036 — deixe em false para desativar) ---
# Credenciais de TESTE (TEST-...) geradas no Painel de Desenvolvedores do
# Mercado Pago. Back URLs/notification URL têm default derivado de
# APP_WEB_URL/APP_API_URL se deixados em branco (ver
# apps/api/src/modules/payments/mercadopago/config.ts).
MERCADOPAGO_ENABLED=false
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_CHECKOUT_SUCCESS_URL=
MERCADOPAGO_CHECKOUT_FAILURE_URL=
MERCADOPAGO_CHECKOUT_PENDING_URL=
MERCADOPAGO_NOTIFICATION_URL=
MERCADOPAGO_MAX_INSTALLMENTS=12

# --- Z-API (WhatsApp Concierge) ---
ZAPI_WEBHOOK_SECRET=TROQUE_POR_SECRET_ZAPI

# --- Concierge ---
CONCIERGE_RETENTION_DAYS=180
CONCIERGE_RETENTION_INTERVAL_HOURS=24

# --- Brevo (e-mail transacional) --- ver docs/integrations/brevo.md
# Sem estas 3, o envio cai em modo preview (loga, nao envia, nao quebra o fluxo)
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=
BREVO_SMTP_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=JLR Beauty

# --- Caminhos de dados persistentes (bind mounts) ---
# Servidor Ubuntu de producao: /srv/databases/jlr_beauty/postgres, /srv/data/jlr_beauty/uploads, /srv/backups/jlr_beauty
# Se omitidos, o compose usa ./.data/postgres e ./.data/uploads (dev portavel, ignorado pelo git).
JLR_PG_DATA_DIR=/srv/databases/jlr_beauty/postgres
JLR_UPLOADS_DIR=/srv/data/jlr_beauty/uploads
JLR_BACKUP_DIR=/srv/backups/jlr_beauty
